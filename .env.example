# =======================================================
# Variables de Entorno - Dsw2025Tpi Backend API (Docker)
# =======================================================

# Entorno de ejecución: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Puerto HTTP en el que escucha la API dentro del contenedor
ASPNETCORE_HTTP_PORTS=8080

# Cadena de conexión hacia Azure SQL Database
ConnectionStrings__DefaultConnection=Server=tcp:sql-server-ics-figueroa.database.windows.net,1433;Initial Catalog=dsw-ecommerce-db;Persist Security Info=False;User ID=dswadmin;Password=TU_PASSWORD_AQUI;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Clave de firmado JWT (requiere un mínimo estricto de 32 caracteres / 256 bits para HMAC-SHA256)
Jwt__Key=ClaveSecretaSuperSeguraParaHmacSha256Minimo32Caracteres!
Jwt__Issuer=Dsw2025TpiApi
Jwt__Audience=Dsw2025TpiClient
